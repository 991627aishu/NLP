# Copy to .env (git-ignored). Every value is optional.
# ── backends: auto = best available, falls back silently, trace records what ran
AYUR_TRANSLATOR_BACKEND=auto        # auto | indictrans2 | rules
AYUR_DENSE_BACKEND=auto             # auto | sentence_transformers | tfidf
AYUR_GENERATOR_BACKEND=extractive   # extractive | llm   (experiments always use extractive)
AYUR_KG_VERSION=auto                # auto | v1 | v2
AYUR_STT_BACKEND=auto               # auto | faster_whisper | none
AYUR_WHISPER_MODEL=small            # tiny | base | small | medium
AYUR_TTS_BACKEND=auto               # auto | edge_tts | gtts | none
# ── safety (keep on)
AYUR_SAFETY_GATE=1
AYUR_EVIDENCE_GATE=1
AYUR_EVIDENCE_MIN_COVERAGE=0.4
# ── optional LLM generator
AYUR_LLM_PROVIDER=anthropic         # anthropic | ollama
AYUR_LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
AYUR_OLLAMA_URL=http://localhost:11434
AYUR_OLLAMA_MODEL=llama3.1:8b
# ── Hugging Face token (only if a model card requires accepting terms)
HF_TOKEN=
# ── Google Gemini Integration (Official google-genai SDK)
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_SEARCH_GROUNDING_ENABLED=true

# ── web server
AYUR_HOST=127.0.0.1
AYUR_PORT=8000
