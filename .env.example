# AyurMitra — Production Environment Template
# For Render deployment, configure these key-value pairs in the Render Dashboard (Environment Tab).
# Secrets must NEVER be checked into Git.

# ── Generative Engine & RAG Configuration
AYUR_GENERATOR_BACKEND=llm         # llm | extractive
AYUR_LLM_PROVIDER=gemini            # gemini | anthropic | ollama
AYUR_LLM_MODEL=gemini-3.5-flash-lite
AYUR_TRANSLATOR_BACKEND=auto        # auto | indictrans2 | rules
AYUR_DENSE_BACKEND=auto             # auto | gemini_embeddings | sentence_transformers | tfidf
AYUR_KG_VERSION=v2                  # v2 (9,537 nodes) | v1 (24 nodes) | auto

# ── Google Gemini Integration (Official google-genai SDK)
# Required for live generative responses and 3072-dim embeddings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_SEARCH_GROUNDING_ENABLED=false

# ── Voice Processing (Optional Server-Side Backends)
AYUR_STT_BACKEND=none               # none (browser Web Speech API fallback) | faster_whisper
AYUR_TTS_BACKEND=edge_tts           # edge_tts | gtts | none (browser Web Speech API fallback)

# ── Clinical Evidence & Safety Guards (Keep enabled in production)
AYUR_SAFETY_GATE=1
AYUR_EVIDENCE_GATE=1
AYUR_EVIDENCE_MIN_COVERAGE=0.4

# ── Web Server & CORS
AYUR_HOST=0.0.0.0
AYUR_PORT=8000
AYUR_CORS_ORIGINS=https://your-service.onrender.com,http://127.0.0.1:8000 # Set to your deployed Render URL and local testing URLs
